<Window x:Class="LibrarySystem.EKnigeProzor"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="E-knjige" Height="478.571" Width="984.89" Background="Orange">
     <Grid>
          <Grid.ColumnDefinitions>
               <ColumnDefinition Width="*" />
               <ColumnDefinition Width="Auto" />
          </Grid.ColumnDefinitions>
          <Grid.RowDefinitions>
               <RowDefinition Height="Auto" />
               <RowDefinition Height="Auto" />
               <RowDefinition Height="*" />
               <RowDefinition Height="Auto" />
          </Grid.RowDefinitions>

          <Label Content="Dostupne E-knjige:" FontWeight="Bold" Grid.Row="1" Margin="10,16,48.4,341.8" Grid.ColumnSpan="2" Grid.RowSpan="2" FontSize="30"/>

          <ListView x:Name="EKnjigeListView" Grid.Row="2" Margin="10,76,450.8,46.8">
               <ListView.View>
                    <GridView>
                         <GridViewColumn Header="Naziv">
                              <GridViewColumn.CellTemplate>
                                   <DataTemplate>
                                        <StackPanel Orientation="Horizontal">
                                             <TextBlock Text="{Binding Naziv}" Margin="0,0,10,0" />
                                        </StackPanel>
                                   </DataTemplate>
                              </GridViewColumn.CellTemplate>
                         </GridViewColumn>
                         <GridViewColumn Header="Autor">
                              <GridViewColumn.CellTemplate>
                                   <DataTemplate>
                                        <StackPanel Orientation="Horizontal">
                                             <TextBlock Text="{Binding Autor}" Margin="0,0,10,0" />
                                        </StackPanel>
                                   </DataTemplate>
                              </GridViewColumn.CellTemplate>
                         </GridViewColumn>
                         <GridViewColumn Header="Datum izdavanja">
                              <GridViewColumn.CellTemplate>
                                   <DataTemplate>
                                        <TextBlock Text="{Binding DatumIzdavanja, StringFormat=dd.MM.yyyy}" Margin="0,0,10,0" />
                                   </DataTemplate>
                              </GridViewColumn.CellTemplate>
                         </GridViewColumn>
                         <GridViewColumn Header="Status dostupnosti">
                              <GridViewColumn.CellTemplate>
                                   <DataTemplate>
                                        <StackPanel Orientation="Horizontal">
                                             <TextBlock Text="{Binding StatusDostupnosti}" Margin="0,0,10,0" />
                                        </StackPanel>
                                   </DataTemplate>
                              </GridViewColumn.CellTemplate>
                         </GridViewColumn>
                    </GridView>
               </ListView.View>
          </ListView>

          <Grid Grid.Column="1" Grid.Row="1">
               <Grid.RowDefinitions>
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="*" />
               </Grid.RowDefinitions>

               <TextBox x:Name="PretraziTextBox" Grid.Row="2" Margin="-192,85,44.6,-121" />
               <Button x:Name="PretraziButton" Content="Pretrazi" Grid.Row="1" Margin="-192,126,44.6,-154" Click="PretraziButton_Click" Grid.RowSpan="2" />
          </Grid>

          <StackPanel Grid.Column="1" Grid.Row="2" Orientation="Vertical" Margin="5"/>

          <Button Content="Izlaz" Grid.Row="2" Margin="824,394,9.8,16.8" Click="IzlazButton_Click"/>
          <Button Content="Obriši" Margin="544,107,254.8,309.8" Click="ObrisiButton_Click" Grid.Row="2"/>
          <Button Content="Dodaj" Margin="544,71,254.8,346.8" Click="DodajButton_Click" Grid.Row="2"/>
          <Button Content="Izmeni" Margin="544,149,254.8,267.8" Click="IzmeniButton_Click" Grid.Row="2"/>
     </Grid>
</Window>
