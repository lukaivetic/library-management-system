<Window x:Class="LibrarySystem.FindBookWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Pronadji knjigu" Height="478.571" Width="984.89" Background="Orange">
     <Grid>
          <Grid.ColumnDefinitions>
               <ColumnDefinition Width="28*"/>
               <ColumnDefinition Width="381*"/>
               <ColumnDefinition Width="Auto"/>
          </Grid.ColumnDefinitions>
          <Grid.RowDefinitions>
               <RowDefinition Height="Auto"/>
               <RowDefinition Height="*"/>
               <RowDefinition Height="Auto"/>
          </Grid.RowDefinitions>
          <TextBlock FontSize="24" FontWeight="Bold" Margin="10,10,0,10" Grid.Column="0" Grid.Row="0" HorizontalAlignment="Left" Grid.ColumnSpan="2">Dostupne knjige:</TextBlock>
          <ListView Grid.Column="0" Grid.Row="1" Margin="10,10,85.8,28.8" x:Name="BookListView" Grid.ColumnSpan="2">
               <ListView.View>
                    <GridView>
                         <GridViewColumn Header="Naziv" DisplayMemberBinding="{Binding Naziv}" Width="150"/>
                         <GridViewColumn Header="Autor" DisplayMemberBinding="{Binding Autor}" Width="150"/>
                         <GridViewColumn Header="Datum Izdavanja" Width="150">
                              <GridViewColumn.DisplayMemberBinding>
                                   <Binding Path="DatumIzdavanja" StringFormat="{}{0:dd.MM.yyyy}"/>
                              </GridViewColumn.DisplayMemberBinding>
                         </GridViewColumn>
                         <GridViewColumn Header="Status Dostupnosti" DisplayMemberBinding="{Binding StatusDostupnosti}" Width="150"/>
                         <GridViewColumn Header="Vrsta Korica" DisplayMemberBinding="{Binding VrstaKorica}" Width="150"/>
                    </GridView>
               </ListView.View>
          </ListView>
          <StackPanel Grid.Column="1" Grid.Row="1" Orientation="Vertical" Grid.ColumnSpan="2" Margin="10">
               <TextBox Margin="747,5,10.2,5" Height="30" x:Name="SearchTextBox"/>
               <Button Margin="747,5,10.2,5" Height="30" Content="Pretraži" Click="SearchButton_Click"/>
               <Button Margin="747,5,10.2,5" Height="30" Content="Dodaj Knjigu" Click="AddBookButton_Click"/>
               <Button Margin="747,5,10.2,5" Height="30" Content="Obriši Knjigu" Click="DeleteBookButton_Click"/>
               <Button Margin="747,5,10.2,5" Height="30" Content="Izmeni" Click="EditBookButton_Click"/>
          </StackPanel>
          <Button Margin="5" Width="100" Height="30" Content="Izlaz" Grid.Column="2" Grid.Row="2" Click="ExitButton_Click"/>
     </Grid>
</Window>
