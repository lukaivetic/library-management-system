<Window x:Class="LibrarySystem.IzmeniEKnjigu"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Izmeni E-knjigu" Height="300" Width="400" Background="Orange">
     <Grid>
          <Grid.RowDefinitions>
               <RowDefinition Height="Auto"/>
               <RowDefinition Height="Auto"/>
               <RowDefinition Height="Auto"/>
               <RowDefinition Height="Auto"/>
               <RowDefinition Height="Auto"/>
               <RowDefinition Height="Auto"/>
          </Grid.RowDefinitions>

          <Label Content="Naziv:" Grid.Row="0" Margin="10" FontWeight="Bold"/>
          <TextBox x:Name="NazivTextBox" Grid.Row="0" Margin="100,0,10,10" MinWidth="200"/>

          <Label Content="Autor:" Grid.Row="1" Margin="10" FontWeight="Bold"/>
          <TextBox x:Name="AutorTextBox" Grid.Row="1" Margin="100,0,10,10" MinWidth="200"/>

          <Label Content="Datum izdavanja:" Grid.Row="2" Margin="10" FontWeight="Bold"/>
          <DatePicker x:Name="DatumIzdavanjaDatePicker" Grid.Row="2" Margin="100,0,10,10" MinWidth="200"/>

          <Button Content="Potvrdi" Grid.Row="5" Margin="10" Click="PotvrdiButton_Click" FontWeight="Bold"/>
     </Grid>
</Window>
