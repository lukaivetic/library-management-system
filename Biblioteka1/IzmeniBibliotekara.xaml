<Window x:Class="LibrarySystem.IzmeniBibliotekaraProzor"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Izmeni bibliotekara" Height="400" Width="300" Background="Orange">
     <Grid>
          <Grid.RowDefinitions>
               <RowDefinition Height="Auto" />
               <RowDefinition Height="Auto" />
               <RowDefinition Height="Auto" />
               <RowDefinition Height="Auto" />
               <RowDefinition Height="Auto" />
               <RowDefinition Height="*" />
               <RowDefinition Height="Auto" />
          </Grid.RowDefinitions>

          <Grid.ColumnDefinitions>
               <ColumnDefinition Width="Auto" />
               <ColumnDefinition Width="*" />
          </Grid.ColumnDefinitions>

          <Label Content="Ime:" Grid.Row="0" Grid.Column="0" VerticalAlignment="Center" Margin="5" FontWeight="Bold" />
          <TextBox x:Name="ImeTextBox" Grid.Row="0" Grid.Column="1" Margin="5" />

          <Label Content="Prezime:" Grid.Row="1" Grid.Column="0" VerticalAlignment="Center" Margin="5" FontWeight="Bold" />
          <TextBox x:Name="PrezimeTextBox" Grid.Row="1" Grid.Column="1" Margin="5" />

          <Label Content="Email:" Grid.Row="2" Grid.Column="0" VerticalAlignment="Center" Margin="5" FontWeight="Bold" />
          <TextBox x:Name="EmailTextBox" Grid.Row="2" Grid.Column="1" Margin="5" />

          <Label Content="Telefon:" Grid.Row="3" Grid.Column="0" VerticalAlignment="Center" Margin="5" FontWeight="Bold" />
          <TextBox x:Name="TelefonTextBox" Grid.Row="3" Grid.Column="1" Margin="5" />

          <Label Content="Adresa:" Grid.Row="4" Grid.Column="0" VerticalAlignment="Center" Margin="5" FontWeight="Bold" />
          <TextBox x:Name="AdresaTextBox" Grid.Row="4" Grid.Column="1" Margin="5" />

          <Button x:Name="PotvrdiButton" Content="Potvrdi" Grid.Row="5" HorizontalAlignment="Center" Margin="28,30,27.6,122.4" Click="PotvrdiButton_Click" Width="238" FontWeight="Bold" Grid.ColumnSpan="2" />
     </Grid>
</Window>
