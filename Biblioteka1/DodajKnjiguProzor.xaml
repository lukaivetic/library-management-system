<Window x:Class="Biblioteka1.DodajKnjiguProzor"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:local="clr-namespace:Biblioteka1"
        mc:Ignorable="d"
        d:DesignHeight="300" d:DesignWidth="400"
        Title="DodajKnjiguProzor" Background="Orange" Height="300" Width="400">

     <Grid>
          <Grid.RowDefinitions>
               <RowDefinition Height="Auto"/>
               <RowDefinition Height="Auto"/>
               <RowDefinition Height="Auto"/>
               <RowDefinition Height="Auto"/>
               <RowDefinition Height="Auto"/>
               <RowDefinition Height="Auto"/>
          </Grid.RowDefinitions>

          <TextBlock Text="Naziv:" Grid.Row="0" Margin="10" FontWeight="Bold"/>
          <TextBox x:Name="NazivTextBox" Grid.Row="0" Margin="100,0,10,10" MinWidth="200"/>

          <TextBlock Text="Autor:" Grid.Row="1" Margin="10" FontWeight="Bold"/>
          <TextBox x:Name="AutorTextBox" Grid.Row="1" Margin="100,0,10,10" MinWidth="200"/>

          <TextBlock Text="Datum izdavanja (DD.MM.GGGG):" Grid.Row="2" Margin="10" FontWeight="Bold"/>
          <TextBox x:Name="DatumIzdavanjaTextBox" Grid.Row="2" Margin="200,0,10,10" MinWidth="200"/>

          <TextBlock Text="Status dostupnosti:" Grid.Row="3" Margin="10" FontWeight="Bold"/>
          <TextBox x:Name="StatusDostupnostiTextBox" Grid.Row="3" Margin="200,0,10,10" MinWidth="200"/>

          <TextBlock Text="Vrsta korica:" Grid.Row="4" Margin="10" FontWeight="Bold"/>
          <TextBox x:Name="VrstaKoricaTextBox" Grid.Row="4" Margin="200,0,10,10" MinWidth="200"/>

          <StackPanel Grid.Row="5" Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,10,10,10">
               <Button Content="Potvrdi" Margin="0,0,10,0" FontWeight="Bold" Click="PotvrdiButton_Click" Width="358"/>
          </StackPanel>
     </Grid>
</Window>
