<Window x:Class="LibrarySystem.VratiKnjiguProzor"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Vrati Knjigu Prozor" Height="300" Width="400"
        Background="Orange">
     <Grid>
          <Grid.RowDefinitions>
               <RowDefinition Height="Auto"/>
               <RowDefinition Height="Auto"/>
               <RowDefinition Height="Auto"/>
               <RowDefinition Height="Auto"/>
               <RowDefinition Height="Auto"/>
               <RowDefinition Height="Auto"/>
          </Grid.RowDefinitions>

          <TextBlock Text="Unesite podatke za vraćanje knjige:" Margin="10" FontSize="18" FontWeight="Bold"/>

          <StackPanel Grid.Row="1" Orientation="Horizontal" Margin="10">
               <TextBlock Text="Naziv knjige: " VerticalAlignment="Center" FontWeight="Bold"/>
               <TextBox x:Name="NazivKnjigeTextBox" Width="280" VerticalAlignment="Center" Margin="5"/>
          </StackPanel>

          <StackPanel Grid.Row="2" Orientation="Horizontal" Margin="10">
               <TextBlock Text="Ime: " VerticalAlignment="Center" FontWeight="Bold"/>
               <TextBox x:Name="ImeTextBox" Width="280" VerticalAlignment="Center" Margin="5"/>
          </StackPanel>

          <StackPanel Grid.Row="3" Orientation="Horizontal" Margin="10">
               <TextBlock Text="Prezime: " VerticalAlignment="Center" FontWeight="Bold"/>
               <TextBox x:Name="PrezimeTextBox" Width="280" VerticalAlignment="Center" Margin="5"/>
          </StackPanel>

          <StackPanel Grid.Row="4" Orientation="Horizontal" HorizontalAlignment="Center"/>
          <Button Content="Izađi" Margin="10" Click="IzadjiButton_Click" Grid.Row="5" FontWeight="Bold"/>
          <Button Content="Vrati" Margin="10" Click="VratiButton_Click" Grid.Row="5" FontWeight="Bold"/>
     </Grid>
</Window>
